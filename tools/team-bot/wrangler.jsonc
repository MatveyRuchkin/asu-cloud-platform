{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "asu-team-bot",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-24",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": false },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "asu-team-bot",
      "database_id": "c39935f1-574e-4d61-aa51-a09991cbdb8b",
      "migrations_dir": "migrations",
    },
  ],
  "queues": {
    "producers": [{ "binding": "JOBS", "queue": "asu-team-bot-jobs" }],
    "consumers": [
      {
        "queue": "asu-team-bot-jobs",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 5,
        "retry_delay": 60,
        "max_concurrency": 1,
        "dead_letter_queue": "asu-team-bot-dlq",
      },
    ],
  },
  "ai": { "binding": "AI" },
  "triggers": { "crons": ["*/15 * * * *"] },
  "vars": {
    "GITHUB_REPOSITORY": "MatveyRuchkin/asu-cloud-platform",
    "GITHUB_REF": "dev",
    "AI_MODEL": "@cf/qwen/qwen3-30b-a3b-fp8",
    "AI_DAILY_GLOBAL_REQUESTS": "40",
    "AI_DAILY_USER_REQUESTS": "4",
    "AI_CONTEXT_CHARS": "6500",
    "AI_MAX_TOKENS": "500",
    "AI_DAILY_NEURON_BUDGET": "8000",
    "AI_DAILY_TOKEN_BUDGET": "240000",
    "ENABLE_YANDEX_FALLBACK": "false",
    "GITHUB_CACHE_TTL": "90",
    "REMINDER_HOURS": "24",
    "ESCALATION_HOURS": "48",
    "STALE_DAYS": "7",
  },
}
