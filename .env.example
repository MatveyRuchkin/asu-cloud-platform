POSTGRES_DB=asu_cloud
POSTGRES_USER=asu_cloud
# Set a unique local password. Never commit .env.
POSTGRES_PASSWORD=
# Database VM: set its private IP to allow the API VM to connect.
POSTGRES_BIND_IP=127.0.0.1
POSTGRES_PORT=5432
# API VM: database VM private IP and its published POSTGRES_PORT.
# Keep db:5432 only when both services run on one Docker host.
DB_HOST=db
DB_PORT=5432
# API VM: set its private IP to allow clients on the VM network.
API_BIND_IP=127.0.0.1
API_PORT=8000
# Required only when starting API. Generate at least 32 random bytes.
SECRET_KEY=
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
