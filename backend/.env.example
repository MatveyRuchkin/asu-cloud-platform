# Пример файла окружения. Скопируйте его в .env и заполните под своё окружение:
#   cp .env.example .env   (Windows: copy .env.example .env)
# Файл .env в Git не попадает: реальные пароли и токены не коммитим.

# Название приложения и режим отладки
APP_NAME=ASU Cloud Platform API
DEBUG=false

# Подключение к PostgreSQL. Локальный экземпляр поднимает DOCKER-01.
DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/app

# Ключ подписи токенов. В учебном проекте подставьте случайную строку.
SECRET_KEY=change-me

# Настройки токенов доступа (см. ADR-007 в docs/architecture/decisions.md)
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Адреса frontend, которым разрешён доступ к API
CORS_ORIGINS=["http://localhost:5173"]
