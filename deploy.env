# Public configuration for one VM. No passwords or signing keys belong here.
# Keep POSTGRES_PASSWORD and SECRET_KEY in the VM's existing ignored .env.
# Apply .env first, deploy.env second (public network settings take precedence).
# docker compose --env-file .env --env-file deploy.env -f compose.yaml -f compose.api.yaml up -d --build --wait

POSTGRES_BIND_IP=0.0.0.0
POSTGRES_PORT=5432
DB_HOST=db
DB_PORT=5432
API_BIND_IP=0.0.0.0
API_PORT=8000
WEB_BIND_IP=0.0.0.0
WEB_PORT=8080
